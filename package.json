{
  "name": "local-plan-agent",
  "productName": "Mercury",
  "version": "0.1.0",
  "description": "Local model coding assistant with collaborative planning",
  "author": "Local Plan Agent contributors",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:e2e": "electron-forge package && playwright test",
    "typecheck": "tsc --noEmit",
    "prepare:mxc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-mxc.ps1",
    "lint": "eslint \"src/main/project-*.ts\" \"src/renderer/ProjectMaps.tsx\" \"src/renderer/project-maps.test.ts\"",
    "format:check": "prettier --check \"src/main/project-{agent-runtime,execution,gateway,map-analyzers,map-types,maps,native-messages,plugin-policy,test-runtime,workers}*.ts\" \"src/renderer/ProjectMaps.tsx\" \"src/renderer/project-maps.test.ts\"",
    "format:projects": "prettier --write \"src/main/project-{agent-runtime,execution,gateway,map-analyzers,map-types,maps,native-messages,plugin-policy,test-runtime,workers}*.ts\" \"src/renderer/ProjectMaps.tsx\" \"src/renderer/project-maps.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@repomix/tree-sitter-wasms": "0.1.17",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.12.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "image-size": "^1.2.1",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^29.1.1",
    "mermaid": "12.2.0",
    "npm": "^11.21.1",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tesseract.js": "^7.0.0",
    "typescript": "5.9.3",
    "unified": "^11.0.5",
    "web-tree-sitter": "0.27.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/plugin-vite": "^7.0.0",
    "@electron-forge/shared-types": "^7.0.0",
    "@playwright/test": "^1.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^37.0.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
